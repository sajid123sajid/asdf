{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zupona-store",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/client"
  },
  "routes": [
    {
      "pattern": "zupona.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "SSLCOMMERZ_IS_SANDBOX": "true",
    "PUBLIC_SITE_URL": "https://zupona.com"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zupona-db",
      "database_id": "8f4a933e-9452-48b4-9a4a-b266df4b0021",
      "migrations_dir": "migrations"
    }
  ]
}
